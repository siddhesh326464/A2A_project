{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Orchestrator Service (Port 8000)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "orchestrator.main:app",
                "--host",
                "127.0.0.1",
                "--port",
                "8000",
                "--reload"
            ],
            "jinja": true,
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Financial Service (Port 8001)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "financial.main:app",
                "--host",
                "127.0.0.1",
                "--port",
                "8001",
                "--reload"
            ],
            "jinja": true,
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        }
    ],
    "compounds": [
        {
            "name": "Run Both Services (Orchestrator + Financial)",
            "configurations": [
                "Orchestrator Service (Port 8000)",
                "Financial Service (Port 8001)"
            ],
            "stopAll": true
        }
    ]
}
